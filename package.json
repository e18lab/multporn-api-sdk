{
  "name": "@your-scope/multporn-api",
  "version": "0.1.0",
  "description": "Unofficial Multporn HTML scraping SDK (Node18+). Typed, with retries/timeouts.",
  "license": "MIT",
  "author": "Maks1mio",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "dev:test": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "fast-xml-parser": "^5.3.0",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^5.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
