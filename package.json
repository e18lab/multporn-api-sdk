{
  "name": "multporn-api-sdk",
  "version": "0.1.4",
  "description": "Unofficial Multporn HTML scraping SDK for Node/Web and React Native (Expo). Typed, with retries/timeouts.",
  "license": "MIT",
  "author": "Maks1mio",
  "type": "module",
  "publishConfig": { "access": "public" },

  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.js",
  "types": "./dist/types/index.d.ts",

  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/rn/index.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.cjs"
      },
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },

  "sideEffects": false,

  "engines": {
    "node": ">=18"
  },

  "scripts": {
    "start": "node examples/dev-server.mjs",
    "clean": "rimraf dist",
    "build": "tsup --config tsup.config.ts",
    "pack": "npm pack",
    "yarn:publish": "yarn publish --access public",
    "npm:publish": "npm publish --access public",
    "prepare": "npm run build",
    "test": "vitest run",
    "dev:test": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },

  "files": [
    "dist"
  ],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maks1mio/multporn-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Maks1mio/multporn-api-sdk/issues"
  },
  "homepage": "https://github.com/Maks1mio/multporn-api-sdk#readme",

  "dependencies": {
    "advanced-html-parser": "^2.2.2",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.3.0",
    "zod": "^3.23.8"
  },

  "devDependencies": {
    "@types/node": "^22.7.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "tsup": "^8.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^4.0.8"
  }
}
